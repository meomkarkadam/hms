<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Wizard form view definition -->
        <record id="view_tiemtable_upload_wizard_form" model="ir.ui.view">
            <field name="name">timetable.import.wizard</field>
            <field name="model">timetable.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Upload in to Time-Table">
                    <group>
                        <field name="excel_file"/>

                    </group>
                    <footer>
<!--                        <button string="Confirm" type="object" name="action_confirm_appointment" class="btn-primary"/>-->
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
4455
        <!-- Window action to open the wizard -->
        <record id="action_timetable_import_wizard" model="ir.actions.act_window">
            <field name="name">Time Table Import Wizard</field>
            <field name="res_model">timetable.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_tiemtable_upload_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!-- Menu item to trigger the wizard -->
