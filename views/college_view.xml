<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_college_tree" model="ir.ui.view">
            <field name="name">college.master.tree</field>
            <field name="model">college.master</field>
            <field name="arch" type="xml">
                <list string="Patient Details">
                    <field name="partner_id"/>
                    <field name="name"/>
                    <field name="age"/>
                    <field name="contact_no"/>
                    <field name="email"/>
                </list>
            </field>
        </record>

        <record id="view_college_form" model="ir.ui.view">
            <field name="name">college.master.form</field>
            <field name="model">college.master</field>
            <field name="arch" type="xml">
                <form string="Doctor Details">
                    <sheet>
                        <group>
                            <field name="partner_id"/>
                            <field name="name"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="contact_no"/>
                            <field name="email"/>

                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_college_view" model="ir.actions.act_window">
            <field name="name">College</field>
            <field name="res_model">college.master</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_student_section" model="ir.actions.act_window">
            <field name="name">Student Section</field>
            <field name="res_model">college.master</field>
            <field name="view_mode">list,form</field>
        </record>



        <record id="action_student_profile" model="ir.actions.act_window">
            <field name="name">Students Profile</field>
            <field name="res_model">student.master</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_student_enrollment" model="ir.actions.act_window">
            <field name="name">Students Enrollment</field>
            <field name="res_model">student.master</field>
            <field name="view_mode">list,form</field>
        </record>

         <record id="action_student_parent_portal" model="ir.actions.act_window">
            <field name="name">Students Parent Portal</field>
            <field name="res_model">student.master</field>
            <field name="view_mode">list,form</field>
        </record>

         <record id="action_student_register" model="ir.actions.act_window">
            <field name="name">Students Register(Academic Year Wise)</field>
            <field name="res_model">student.master</field>
            <field name="view_mode">list,form</field>
        </record>

          <record id="action_student_attendance" model="ir.actions.act_window">
            <field name="name">Students Attendance</field>
            <field name="res_model">student.master</field>
            <field name="view_mode">list,form</field>
          </record>

        <record id="action_bio_student_attendance" model="ir.actions.act_window">
            <field name="name">Students Bio Attendance</field>
            <field name="res_model">student.master</field>
            <field name="view_mode">list,form</field>
          </record>







        <menuitem id="menu_patient" name="College"
                  parent="menu_medical_root" sequence="2"
                  action="action_college_view"/>

        <menuitem id="menu_studen_section" name="Student Section"
                  parent="menu_patient" sequence="1"
                  action="action_student_section"/>





        <menuitem id="menu_student_profile" name="Student Profiles"
                  parent="menu_studen_section" sequence="1"
                  action="action_student_profile"/>

        <menuitem id="menu_student_enrollment" name="Student Enrollment"
                  parent="menu_studen_section" sequence="2"
                  action="action_student_enrollment"/>

        <menuitem id="menu_student_parent_portal" name="Student Parent Portal"
                  parent="menu_studen_section" sequence="3"
                  action="action_student_parent_portal"/>

         <menuitem id="menu_student_register" name="Student Register(Academic Year Wise)"
                  parent="menu_studen_section" sequence="4"
                  action="action_student_register"/>

        <menuitem id="menu_student_attendance" name="Student Attendance Management System"
                  parent="menu_studen_section" sequence="5"
                  action="action_student_attendance"/>

         <menuitem id="menu_student_bio_attendance" name="Student Bio Attendance"
                  parent="menu_student_attendance" sequence="1"
                  action="action_bio_student_attendance"/>
















    </data>
</odoo>
