<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

         <record id="view_medical_tree" model="ir.ui.view">
            <field name="name">medical.store.tree</field>
            <field name="model">medical.store</field>
            <field name="arch" type="xml">
                <list string="Medical Details">
                    <field name="manager"/>
                    <field name="product_id"/>
                </list>
            </field>
        </record>

        <record id="view_medical_form" model="ir.ui.view">
            <field name="name">medical.store.form</field>
            <field name="model">medical.store</field>
            <field name="arch" type="xml">
                <form string="Medical Store">
                    <sheet>
                        <group>
                            <field name="product_id">
                            </field>
<!--                            <field name="medicine_ids">-->
<!--                            </field>-->
                            <field name="manager">
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_store_view" model="ir.actions.act_window">
            <field name="name">Stores</field>
            <field name="res_model">medical.store</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_store" name="Admin"
                  parent="menu_medical_root" sequence="3"
                  action="action_store_view"/>
    </data>
</odoo>




