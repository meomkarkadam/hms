<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_patient_tree" model="ir.ui.view">
            <field name="name">patient.master.tree</field>
            <field name="model">patient.master</field>
            <field name="arch" type="xml">
                <list string="Patient Details">
                    <field name="doctor_id"/>
                    <field name="doctor_id"/>
                </list>
            </field>
        </record>
        <record id="view_patient_form" model="ir.ui.view">
            <field name="name">patient.master.form</field>
            <field name="model">patient.master</field>
            <field name="arch" type="xml">
                <form string="Patient Details">
                    <sheet>
                        <group>
                            <field name="doctor_id"/>
                            <field name="patient_id"/>

                        </group>

                    </sheet>
                </form>

            </field>
        </record>

        <record id="action_patient_view" model="ir.actions.act_window">
            <field name="name">patient</field>
            <field name="res_model">patient.master</field>
            <field name="view_mode">list,form</field>
        </record>











    </data>
</odoo>


