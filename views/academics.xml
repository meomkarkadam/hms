<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_college_tree" model="ir.ui.view">
            <field name="name">academics.master.tree</field>
            <field name="model">academics.master</field>
            <field name="arch" type="xml">
                <list string="Academics Flow">
                    <field name="academic_year"/>
                    <field name="course"/>
                </list>
            </field>
        </record>

        <record id="view_college_form" model="ir.ui.view">
            <field name="name">academics.master.form</field>
            <field name="model">academics.master</field>
            <field name="arch" type="xml">
                <form string="Academics Details">
                    <sheet>
                        <group>
                            <field name="academic_year"/>
                        </group>
                        <group>
                            <field name="course"/>
                        </group>
                        <header>
                            <button name="action_open_wizard"
                                    type="object"
                                    string="Open Wizard"
                                    class="btn-primary"/>
                            <button string="Cancel"
                                    special="cancel"/>
                        </header>

                        <notebook>
                            <page string="Subjects">

                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="day"/>
                                        <field name="start_time" widget="time_picker"/>
                                        <field name="end_time" widget="time_picker"/>
                                        <field name="" />

                                    </list>

                                </field>

                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


         <record id="action_academics" model="ir.actions.act_window">
            <field name="name">Academics</field>
            <field name="res_model">academics.master</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_faculty_management" model="ir.actions.act_window">
            <field name="name">Faculty</field>
            <field name="res_model">academics.master</field>
            <field name="view_mode">list,form</field>
        </record>

         <record id="action_lecture_management" model="ir.actions.act_window">
            <field name="name">Lecture Management System</field>
            <field name="res_model">academics.master</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_student_attendance_report" model="ir.actions.act_window">
            <field name="name">Student Attendance Report</field>
            <field name="res_model">academics.master</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_classwise_student_attendance_report" model="ir.actions.act_window">
            <field name="name">Classwise Student Attendance Report</field>
            <field name="res_model">academics.master</field>
            <field name="view_mode">list,form</field>
        </record>

         <record id="action_academics_year" model="ir.actions.act_window">
            <field name="name">Acedemic Year</field>
            <field name="res_model">academics.master</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="action_timetable" model="ir.actions.act_window">
            <field name="name">Timetable</field>
            <field name="res_model">academics.master</field>
            <field name="view_mode">list,form</field>
        </record>
         <record id="action_lecture_scheduler" model="ir.actions.act_window">
            <field name="name">Timetable</field>
            <field name="res_model">academics.master</field>
            <field name="view_mode">list,form</field>
        </record>




         <menuitem id="menu_student_profile" name="Student Profiles"
                  parent="menu_studen_section" sequence="1"
                  action="action_student_profile"/>



        <menuitem id="menu_academics" name="Academics"
                  parent="menu_patient" sequence="2"
                  action="action_academics"/>

         <menuitem id="menu_faculty" name="Faculty Report"
                  parent="menu_academics" sequence="2"
                  action="action_faculty_management"/>


        <menuitem id="menu_lecture_management_system" name="Lecture Management System(LMS)"
                  parent="menu_academics" sequence="3"
                  action="action_lecture_management"/>

        <menuitem id="menu_timetable" name="Time Table Creation"
                  parent="menu_lecture_management_system" sequence="1"
                  action="action_timetable"/>

        <menuitem id="menu_lecture_scheduler" name="Regular Lecture Scheduler"
                  parent="menu_lecture_management_system" sequence="2"
                  action="action_lecture_scheduler"/>

        <menuitem id="menu_student_attendance_report" name="Student Attendance Report"
                  parent="menu_academics" sequence="4"
                  action="action_student_attendance_report"/>

         <menuitem id="menu_classwise_student_attendance_report" name="Classwise Student Attendance Report"
                  parent="menu_student_attendance_report" sequence="1"
                  action="action_classwise_student_attendance_report"/>

         <menuitem id="menu_academic_year" name="Academic Year"
                  parent="menu_academics" sequence="1"
                  action="action_academics_year"/>




















    </data>
</odoo>
