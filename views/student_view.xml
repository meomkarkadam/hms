<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_student_tree" model="ir.ui.view">
            <field name="name">student.master.tree</field>
            <field name="model">student.master</field>
            <field name="arch" type="xml">
                <list string="Student Details">

                    <field name="partner_id" widget="many2one_avatar" />
                    <field name="mobile" readonly="1"/>
                    <field name="phone" readonly="1"/>
                    <field name="email" readonly="1"/>
                    <field name="street" readonly="1"/>
                    <field name="city" readonly="1"/>
                    <field name="state_id" readonly="1"/>
                    <field name="zip" readonly="1"/>
                    <field name="country_id" readonly="1"/>


                </list>
            </field>
        </record>


        <record id="view_student_form" model="ir.ui.view">
            <field name="name">student.master.form</field>
            <field name="model">student.master</field>
            <field name="arch" type="xml">
                <form string="Student Details">
                    <sheet>
                        <group>
                            <div class="text-start" >
                            <field name="image_1920" widget="image" class="oe_avatar"  align="center" options="{'size': [200, 200]}"/>
                            </div>

                        </group>
                        <group>
                            <field name="partner_id" widget="many2one_avatar" />

                        </group>

                <group string="Contact Info">
                    <field name="mobile" readonly="1"/>
                    <field name="phone" readonly="1"/>
                    <field name="email" readonly="1"/>
                </group>

                <group string="Address(As Per Aadhar)">
                    <field name="street" readonly="1"/>
                    <field name="city" readonly="1"/>
                    <field name="state_id" readonly="1"/>
                    <field name="zip" readonly="1"/>
                    <field name="country_id" readonly="1"/>
                </group>

                <group string="Parents Details">
                     <field name="fathername" readonly="1">
                        </field>
                     <field name="designation">
                        </field>

                </group>

                <group string="Educational Details">

                </group>

                 <group string="Documents">

                </group>




                    </sheet>
                </form>
            </field>
        </record>



        <record id="action_student_attendance" model="ir.actions.act_window">
            <field name="name">Student Management</field>
            <field name="res_model">student.master</field>
            <field name="view_mode">form</field>
        </record>

        <record id="action_student_academics" model="ir.actions.act_window">
            <field name="name">Student Management</field>
            <field name="res_model">student.master</field>
            <field name="view_mode">form</field>
        </record>

