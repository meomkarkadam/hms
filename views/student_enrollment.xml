<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_student_enrollment_tree" model="ir.ui.view">
            <field name="name">student.enrollment.tree</field>
            <field name="model">student.enrollment</field>
            <field name="arch" type="xml">
                <list string="Student Enrollment">

                    <field name="name" />



                </list>
            </field>
        </record>


        <record id="view_student_enrollment_form" model="ir.ui.view">
            <field name="name">student.enrollment.form</field>
            <field name="model">student.enrollment</field>
            <field name="arch" type="xml">
                <form string="Student Enrollment">
                    <sheet>
                        <group string="Personal Details">
                            <field name="name"/>
                            <field name="academic_year"/>
                            <field name="ref_id"/>
                            <field name="erp_id"/>

                        </group>

                        <group string="Academics Details">
                            <field name="ace_class"/>
                            <field name="course"/>




                        </group>

                        <button name="action_test_button"
                                type="object"
                                string="Enroll"
                                class="btn-primary"/>


                    </sheet>
                </form>
            </field>
        </record>



<!--        <record id="action_student_enrollment" model="ir.actions.act_window">-->
<!--            <field name="name">Student Enrollment</field>-->
<!--            <field name="res_model">student.enrollment</field>-->
<!--            <field name="view_mode">list,form</field>-->
<!--        </record>-->







    </data>
</odoo>
